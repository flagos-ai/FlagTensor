ARG BASE_IMAGE=nvidia/cuda:12.8.0-devel-ubuntu24.04
FROM ${BASE_IMAGE}

# Builds strictly against the base Ubuntu release's system python3
# (3.10 on Ubuntu 22.04, 3.12 on Ubuntu 24.04) with no external PPA.
ARG DEB_VERSION_SUFFIX=auto
ARG PYTHON_VERSION=
ARG TORCH_INDEX=https://resource.flagos.net/repository/flagos-pypi-nvidia/simple
ARG TORCH_PACKAGES="torch==2.10.0+cu128 triton==3.6.0"
ARG FLAGOS_APT=
ARG FLAGOS_APT_KEY=https://resource.flagos.net/repository/apt-keys/pub/flagos-apt-public-key.asc

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_BREAK_SYSTEM_PACKAGES=1

RUN . /etc/os-release \
    && case "${ID}:${VERSION_ID}" in \
        ubuntu:22.04) expected_py=3.10 ;; \
        ubuntu:24.04) expected_py=3.12 ;; \
        *) echo "ERROR: unsupported suite ${ID} ${VERSION_ID}" >&2; exit 1 ;; \
       esac \
    && if [ -n "${PYTHON_VERSION}" ] && [ "${PYTHON_VERSION}" != "${expected_py}" ]; then \
        echo "ERROR: PYTHON_VERSION=${PYTHON_VERSION} conflicts with ${PRETTY_NAME} native Python ${expected_py}" >&2; \
        exit 1; \
       fi \
    && apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl debhelper devscripts dh-python \
        dpkg-dev fakeroot git libfmt-dev ninja-build nlohmann-json3-dev \
        patchelf python3 python3-dev python3-pip python3-venv \
    && pyver="$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')" \
    && [ "${pyver}" = "${expected_py}" ] \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir \
        "build" "cmake>=3.25,<4.0" "pybind11==3.0.3" \
        "setuptools>=64" "wheel" \
    && (python3 -m pip install --no-cache-dir --index-url "${TORCH_INDEX}" ${TORCH_PACKAGES} \
        || python3 -m pip install --no-cache-dir \
            --index-url "${TORCH_INDEX}" \
            --extra-index-url https://download.pytorch.org/whl/cu128 \
            --extra-index-url https://pypi.org/simple \
            ${TORCH_PACKAGES})

COPY packaging/debian/local-deps/ /tmp/local-deps/
RUN if ls /tmp/local-deps/libtriton-jit-nvidia*.deb >/dev/null 2>&1; then \
        . /etc/os-release; \
        arch="$(dpkg --print-architecture)"; \
        set -- /tmp/local-deps/libtriton-jit-nvidia*"+${ID}${VERSION_ID}_${arch}.deb"; \
        [ -e "$1" ] || set -- /tmp/local-deps/libtriton-jit-nvidia*"_${arch}.deb"; \
        [ -e "$1" ] || set -- /tmp/local-deps/libtriton-jit-nvidia*.deb; \
        apt-get update && apt-get install -y "$@"; \
    else \
        . /etc/os-release; \
        apt_entry="${FLAGOS_APT:-https://resource.flagos.net/repository/flagos-apt-ubuntu${VERSION_ID} ${VERSION_CODENAME} main}"; \
        install -d -m 0755 /etc/apt/keyrings; \
        curl -fsSL "${FLAGOS_APT_KEY}" -o /etc/apt/keyrings/flagos.asc; \
        echo "deb [signed-by=/etc/apt/keyrings/flagos.asc] ${apt_entry}" \
          > /etc/apt/sources.list.d/flagos.list; \
        apt-get update; \
        apt-get install -y libtriton-jit-nvidia-dev; \
    fi \
    && rm -rf /var/lib/apt/lists/*

COPY . /workspace/FlagTensor
WORKDIR /workspace/FlagTensor

RUN cp -r packaging/debian debian && \
    if [ "${DEB_VERSION_SUFFIX}" = "auto" ]; then \
        . /etc/os-release && suffix="+${ID}${VERSION_ID}"; \
    else suffix="${DEB_VERSION_SUFFIX}"; fi && \
    if [ -n "${suffix}" ]; then \
        base="$(dpkg-parsechangelog -l debian/changelog -SVersion)" && \
        case "${base}" in *"${suffix}") ;; *) \
            clean_base="$(printf '%s' "${base}" | sed -E 's/\+ubuntu[0-9]+\.[0-9]+$//')" && \
            DEBFULLNAME="FlagOS Contributors" DEBEMAIL="contact@flagos.io" \
            dch -b -v "${clean_base}${suffix}" -D unstable --force-distribution \
                "Rebuild for $(. /etc/os-release && echo "${PRETTY_NAME}")." ;; \
        esac; \
    fi
RUN dpkg-buildpackage -us -uc -b -d

RUN install -d /output \
    && find /output -mindepth 1 -delete \
    && find /workspace -maxdepth 1 -name "*flagtensor*.deb" -exec cp {} /output/ \; \
    && find /workspace -maxdepth 1 -name "flagtensor_*.changes" -exec cp {} /output/ \; \
    && ls -lh /output/
