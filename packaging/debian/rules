#!/usr/bin/make -f

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)
DEB_HOST_GNU_TYPE ?= $(shell dpkg-architecture -qDEB_HOST_GNU_TYPE)
BUILD_DIR = $(CURDIR)/obj-$(DEB_HOST_GNU_TYPE)
WHEEL_DIR = $(BUILD_DIR)/wheel
PYDIR = $(CURDIR)/debian/python3-flagtensor/usr/lib/python3/dist-packages
TORCH_LIBRARY_DIR := $(shell python3 -c "import importlib.util, os; s = importlib.util.find_spec('torch'); print(os.path.join(os.path.dirname(s.origin), 'lib'))")
CUDA_COMPAT_LIBRARY := $(shell readlink -f /usr/local/cuda/compat/libcuda.so.1 2>/dev/null)
CUDA_COMPAT_PACKAGE := $(shell test -n "$(CUDA_COMPAT_LIBRARY)" && dpkg-query -S "$(CUDA_COMPAT_LIBRARY)" 2>/dev/null | cut -d: -f1 | head -1)
DEB_PRIVATE_LIBRARY_DIRS ?= $(TORCH_LIBRARY_DIR):/usr/local/cuda/compat:/usr/local/cuda/lib64/stubs
DEB_SHLIBDEPS_EXCLUDE_PACKAGES ?= libtriton-jit-nvidia $(CUDA_COMPAT_PACKAGE)

%:
	dh $@ --with python3

override_dh_auto_configure:
	cmake -S . -B $(BUILD_DIR) -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib/$(DEB_HOST_MULTIARCH) \
		-DFLAGTENSOR_BACKEND=CUDA \
		-DFLAGTENSOR_BUILD_C_EXTENSIONS=ON \
		-DFLAGTENSOR_INSTALL=ON \
		-DFLAGTENSOR_PYTHON_INSTALL_DIR=lib/python3/dist-packages/flagtensor \
		-DFLAGTENSOR_USE_EXTERNAL_TRITON_JIT=ON \
		-DFETCHCONTENT_FULLY_DISCONNECTED=ON

override_dh_auto_build:
	cmake --build $(BUILD_DIR) --parallel
	mkdir -p $(WHEEL_DIR)
	python3 -m build --wheel --no-isolation --outdir $(WHEEL_DIR)

override_dh_auto_install:
	DESTDIR=$(CURDIR)/debian/tmp cmake --install $(BUILD_DIR)
	find debian/tmp/usr/lib -name '*.so*' -type f \
		-exec patchelf --remove-rpath {} \;
	@wheel="$$(ls -1 $(WHEEL_DIR)/flagtensor-*.whl | head -1)"; \
	mkdir -p $(PYDIR); \
	python3 -m pip install --no-deps --no-compile --no-index \
		--break-system-packages --target=$(PYDIR) "$$wheel"
	rm -f $(PYDIR)/flagtensor-*.dist-info/RECORD
	test -f $(PYDIR)/flagtensor/runtime/backend/_nvidia/tune_configs.yaml

override_dh_auto_test:
	test -f $(BUILD_DIR)/lib/libflagtensor.so
	test -n "$$(find $(BUILD_DIR) -name 'c_operators*.so' -print -quit)"

override_dh_shlibdeps:
	# Scan every native object so distro dependencies are retained. PyTorch,
	# CUDA, and TritonJIT are supplied by the selected vendor environment;
	# TritonJIT remains an explicit versioned dependency in debian/control.
	dh_shlibdeps -l$(DEB_PRIVATE_LIBRARY_DIRS) -- \
		--ignore-missing-info \
		$(addprefix -x,$(DEB_SHLIBDEPS_EXCLUDE_PACKAGES))

override_dh_dwz:
	@echo "Skipping dwz for CUDA/PyTorch-linked libraries"
